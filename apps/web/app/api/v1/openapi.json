{
    "openapi": "3.0.0",
    "info": {
        "title": "ClinixPro API v1",
        "description": "Enterprise-grade SaaS API for Clinic Management",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "Main API v1"
        }
    ],
    "paths": {
        "/patients": {
            "get": {
                "summary": "Search Patients",
                "description": "High-performance search by name, phone, or MRN.",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "description": "Search term",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of patients matching query"
                    }
                }
            }
        },
        "/appointments": {
            "get": {
                "summary": "List Appointments",
                "responses": {
                    "200": {
                        "description": "List of appointments"
                    }
                }
            }
        }
    }
}